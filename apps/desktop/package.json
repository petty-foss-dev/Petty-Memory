{
  "name": "@enve-memory/desktop",
  "productName": "Petty Memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Petty Memory desktop app",
  "author": "Enve Media",
  "homepage": "https://github.com/petty-foss-dev/Petty-Memory",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 \"e2e/*.test.ts\"",
    "icon": "node scripts/icon.mjs",
    "dist": "node scripts/dist.mjs",
    "dist:mac": "node scripts/dist.mjs --mac",
    "dist:win": "node scripts/dist.mjs --win",
    "dist:linux": "node scripts/dist.mjs --linux",
    "verify:dist": "node scripts/verify-dist.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "devDependencies": {
    "@enve-memory/ai": "0.1.0",
    "@enve-memory/api": "0.1.0",
    "@enve-memory/cli": "0.1.0",
    "@enve-memory/core": "0.1.0",
    "@enve-memory/embeddings": "0.1.0",
    "@enve-memory/importers": "0.1.0",
    "@enve-memory/ingestion": "0.1.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/jsdom": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
}
